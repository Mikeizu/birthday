# Optional locally: create the first admin password in the app.
# Required before initial production launch unless admin setup is already saved.
# Supply a unique password of at least 12 characters securely; never commit .env.
# ADMIN_PASSWORD=

# Persistent database file. Back up using SQLite's backup API.
# DATABASE_PATH=.data/birthdays.sqlite
# HOST=127.0.0.1
# PORT=3001

# Automatic WhatsApp messages require Meta Business access and approved templates.
# Put the token in secure hosting environment settings, or your untracked local .env.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_RECIPIENT_PHONE=
WHATSAPP_TEMPLATE_NAME=impact23_birthday_reminder
WHATSAPP_GREETING_TEMPLATE_NAME=impact23_birthday_greeting
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_SEND_TIME=08:00
APP_TIME_ZONE=Africa/Lagos
